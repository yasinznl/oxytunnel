[Unit]
Description=GRE tunnel and port forward (oxytunnel)
After=network.target netfilter-persistent.service

[Service]
Type=oneshot
TimeoutStartSec=60
TimeoutStopSec=30
ExecStart=/usr/local/bin/oxytunnel-up
ExecStop=/usr/local/bin/oxytunnel-down
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
