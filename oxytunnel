#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=/dev/null
source /usr/local/lib/oxytunnel/lib.sh

usage() {
  cat <<EOF
oxytunnel — GRE tunnel, port forward, and health watch

Open the management menu:
  sudo oxytunnel

Commands:
  oxytunnel
  oxytunnel setup
  oxytunnel status
  oxytunnel health
  oxytunnel log
  oxytunnel restart
  oxytunnel port list
  oxytunnel port add <port> [port...]
  oxytunnel port del <port> [port...]
  oxytunnel port set <port> [port...]
  oxytunnel role iran|foreign

Access: root only.
Config: ${CONF} (mode 600)
Log:    ${LOG_FILE} (mode 640)

Port changes are stored in the config and applied by restarting the service.
Forwarding is active only when this server's role is iran.
On the foreign server the panel should listen on 0.0.0.0, and clients
should connect to the Iran public IP.
EOF
}

cmd_status() {
  local reason
  load_conf
  local state="inactive"
  if systemctl is-active --quiet "${UNIT}"; then
    state="active"
  fi
  echo "role:    ${ROLE}"
  echo "speed:   ${SPEED}"
  echo "service: ${state}"
  echo "public:  ${LOCAL_IP} -> ${REMOTE_IP}"
  echo "tunnel:  ${TUN_IP}/${CIDR}  peer ${PEER_IP:-unset}  iface ${TUN_NAME}  mtu ${MTU}"
  if [[ -n "${PORTS:-}" ]]; then
    echo "ports:   ${PORTS}"
  else
    echo "ports:   (none)"
  fi
  if ip -4 -br addr show "$TUN_NAME" >/dev/null 2>&1; then
    ip -4 -br addr show "$TUN_NAME"
  else
    echo "iface:   down"
  fi
  if reason="$(probe_tunnel)"; then
    echo "health:  ok"
  else
    echo "health:  ${reason}"
  fi
  if [[ "$ROLE" == "iran" ]] && command -v iptables >/dev/null 2>&1; then
    echo "dnat:"
    ipt -t nat -S "$CHAIN_DNAT" 2>/dev/null || echo "  (no rules)"
  fi
  if systemctl is-active --quiet oxytunnel-health.timer; then
    echo "watch:   timer active"
  else
    echo "watch:   timer inactive"
  fi
}

require_iran() {
  load_conf
  [[ "$ROLE" == "iran" ]] || die "This server is '${ROLE}'. Add or remove ports on the Iran server."
}

cmd_port_list() {
  load_conf
  if [[ -n "${PORTS:-}" ]]; then
    echo "$PORTS"
  else
    echo "(none)"
  fi
}

cmd_port_add() {
  local add current merged
  [[ $# -ge 1 ]] || die "Usage: oxytunnel port add <port> [port...]"
  require_iran
  add="$(parse_ports "$*")" || exit 1
  current="$(parse_ports "${PORTS:-}")" || exit 1
  merged="$(parse_ports "$current $add")" || exit 1
  if [[ "$merged" == "$current" ]]; then
    echo "Ports unchanged: ${merged}"
    return 0
  fi
  conf_set PORTS "$merged"
  restart_service
  echo "Forwarding ${merged} to ${PEER_IP}"
}

cmd_port_del() {
  local del p kept="" removed=0
  [[ $# -ge 1 ]] || die "Usage: oxytunnel port del <port> [port...]"
  require_iran
  del="$(parse_ports "$*")" || exit 1
  for p in $PORTS; do
    case " $del " in
      *" $p "*) removed=1 ;;
      *) kept="${kept:+$kept }$p" ;;
    esac
  done
  if [[ "$removed" -eq 0 ]]; then
    echo "None of those ports are in the forward list."
    return 0
  fi
  conf_set PORTS "$kept"
  restart_service
  if [[ -n "$kept" ]]; then
    echo "Forwarding ${kept} to ${PEER_IP}"
  else
    echo "No ports are forwarded. The GRE tunnel is still up."
  fi
}

cmd_port_set() {
  local new current
  [[ $# -ge 1 ]] || die "Usage: oxytunnel port set <port> [port...]"
  require_iran
  new="$(parse_ports "$*")" || exit 1
  [[ -n "$new" ]] || die "Give at least one port."
  current="$(parse_ports "${PORTS:-}")" || exit 1
  if [[ "$new" == "$current" ]]; then
    echo "Ports unchanged: ${new}"
    return 0
  fi
  conf_set PORTS "$new"
  restart_service
  echo "Forwarding ${new} to ${PEER_IP}"
}

cmd_role() {
  local new
  [[ -n "${1:-}" ]] || die "Usage: oxytunnel role iran|foreign"
  load_conf
  new="$(normalize_role "$1")" || die "Role must be iran or foreign."
  if [[ "$new" == "$ROLE" ]]; then
    echo "Role unchanged: ${ROLE}"
    return 0
  fi
  if [[ "$new" == "iran" && -z "${PORTS:-}" ]]; then
    echo "Role will be iran. After this, add ports: oxytunnel port add 443"
  fi
  conf_set ROLE "$new"
  restart_service
  echo "Role is ${new}"
}

cmd_log() {
  local lines="${1:-40}"
  [[ "$lines" =~ ^[0-9]+$ ]] || lines=40
  if [[ ! -f "$LOG_FILE" ]]; then
    echo "No log yet: ${LOG_FILE}"
    return 0
  fi
  tail -n "$lines" "$LOG_FILE"
}

if [[ -t 1 ]]; then
  C_RESET=$'\033[0m'
  C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'
  C_RED=$'\033[31m'
  C_GREEN=$'\033[32m'
  C_CYAN=$'\033[36m'
  C_YELLOW=$'\033[33m'
else
  C_RESET=""
  C_BOLD=""
  C_DIM=""
  C_RED=""
  C_GREEN=""
  C_CYAN=""
  C_YELLOW=""
fi

ui_rule() {
  printf '%b\n' "${C_CYAN}------------------------------------------------------------------${C_RESET}"
}

pause_menu() {
  echo
  printf '%b' "${C_DIM}  Press Enter to continue...${C_RESET}"
  read -r _ || true
}

menu_banner() {
  local name="none" role="-" state="absent" tone="$C_DIM"
  printf '\033[H\033[2J' 2>/dev/null || true
  ui_rule
  printf '%b\n' "${C_BOLD}${C_CYAN}  OXYTUNNEL${C_RESET}  ${C_DIM}GRE tunnel manager${C_RESET}"
  ui_rule
  if [[ -f "$CONF" ]]; then
    load_conf
    name="$TUN_NAME"
    role="$ROLE"
    if ! ip link show "$TUN_NAME" >/dev/null 2>&1; then
      state="down"
      tone="$C_RED"
    elif systemctl is-active --quiet "$UNIT"; then
      state="running"
      tone="$C_GREEN"
    else
      state="stopped"
      tone="$C_YELLOW"
    fi
  fi
  printf '  %-12s %s\n' "Tunnel" "$name"
  printf '  %-12s %s\n' "Role" "$role"
  printf '  %-12s %b%s%b\n' "State" "$tone" "$state" "$C_RESET"
  ui_rule
}

cmd_new_tunnel() {
  local answer=""
  if [[ -f "$CONF" ]]; then
    printf '%b' "${C_YELLOW}  Replace the current tunnel? [y/N]:${C_RESET} "
    read -r answer || true
    [[ "${answer:-}" =~ ^[Yy]$ ]] || { echo "  Cancelled."; return 0; }
  fi
  ROLE=""
  ROLE_SET=0
  PORTS_SET=0
  LOCAL_IP=""
  REMOTE_IP=""
  TUN_IP=""
  PEER_IP=""
  PORTS=""
  SPEED=""
  SPEED_SET=0
  CIDR="30"
  MTU="1476"
  TUN_NAME="oxytunnel"
  collect_tunnel_answers
  assert_tunnel_settings
  ensure_iran_packages
  write_tunnel_conf
  systemctl daemon-reload
  systemctl enable "${UNIT}" >/dev/null
  systemctl enable oxytunnel-health.timer >/dev/null
  restart_service
  systemctl start oxytunnel-health.timer >/dev/null 2>&1 || true
  log_event notice "tunnel configuration saved from menu"
  echo "  Tunnel saved and restarted."
}

cmd_start() {
  if [[ ! -f "$CONF" ]]; then
    echo "  No tunnel is configured."
    return 0
  fi
  if systemctl is-active --quiet "$UNIT" && ip link show "$(conf_get TUN_NAME)" >/dev/null 2>&1; then
    echo "  Tunnel is already running."
    return 0
  fi
  systemctl enable "$UNIT" >/dev/null
  systemctl start "$UNIT"
  log_event notice "tunnel started from the menu"
  echo "  Tunnel started."
}

cmd_health() {
  local svc="unknown" flags="" addr="" ping_out="" loss="" result="healthy" tone="$C_GREEN"
  echo
  printf '%b\n' "${C_BOLD}  Health check${C_RESET}"
  ui_rule
  if [[ ! -f "$CONF" ]]; then
    echo "  No tunnel is configured."
    ui_rule
    return 0
  fi
  load_conf
  svc="$(systemctl is-active "$UNIT" 2>/dev/null || true)"
  [[ -n "$svc" ]] || svc="unknown"
  printf '  %-14s %s\n' "Service" "$svc"
  if ip link show "$TUN_NAME" >/dev/null 2>&1; then
    flags="$(ip -o link show "$TUN_NAME" 2>/dev/null | awk '{print $3}')"
    if [[ "$flags" == *UP* ]]; then
      printf '  %-14s %b%s%b\n' "Interface" "$C_GREEN" "up" "$C_RESET"
    else
      printf '  %-14s %b%s%b\n' "Interface" "$C_RED" "down" "$C_RESET"
      result="failed"
      tone="$C_RED"
    fi
  else
    printf '  %-14s %b%s%b\n' "Interface" "$C_RED" "missing" "$C_RESET"
    result="failed"
    tone="$C_RED"
  fi
  addr="$(ip -4 addr show dev "$TUN_NAME" 2>/dev/null || true)"
  if [[ "$addr" == *"inet ${TUN_IP}/"* || "$addr" == *"inet ${TUN_IP} "* ]]; then
    printf '  %-14s %s\n' "Address" "${TUN_IP}/${CIDR}"
  else
    printf '  %-14s %b%s%b\n' "Address" "$C_RED" "missing" "$C_RESET"
    result="failed"
    tone="$C_RED"
  fi
  if [[ -z "${PEER_IP:-}" ]]; then
    printf '  %-14s %b%s%b\n' "Peer" "$C_RED" "not set" "$C_RESET"
    result="failed"
    tone="$C_RED"
  elif ! command -v ping >/dev/null 2>&1; then
    printf '  %-14s %s\n' "Peer" "ping is not installed"
    result="failed"
    tone="$C_RED"
  else
    ping_out="$(ping -c 3 -W 2 "$PEER_IP" 2>&1 || true)"
    loss="$(printf '%s\n' "$ping_out" | awk -F',' '/packets transmitted/ {gsub(/^ +/,"",$2); print $2; exit}')"
    if printf '%s\n' "$ping_out" | grep -q "bytes from"; then
      printf '  %-14s %b%s%b\n' "Peer" "$C_GREEN" "${PEER_IP} reachable (${loss:-reply received})" "$C_RESET"
    else
      printf '  %-14s %b%s%b\n' "Peer" "$C_RED" "${PEER_IP} did not answer" "$C_RESET"
      result="failed"
      tone="$C_RED"
    fi
  fi
  if [[ "$ROLE" == "iran" ]]; then
    if command -v iptables >/dev/null 2>&1 && ipt -t nat -S "$CHAIN_DNAT" >/dev/null 2>&1; then
      printf '  %-14s %s\n' "Forward" "${PORTS:-none}"
    else
      printf '  %-14s %b%s%b\n' "Forward" "$C_RED" "rules missing" "$C_RESET"
      result="failed"
      tone="$C_RED"
    fi
  fi
  ui_rule
  printf '  %-14s %b%s%b\n' "Result" "$tone" "$result" "$C_RESET"
  log_event notice "manual health check result=${result} service=${svc} peer=${PEER_IP:-unset}"
}

cmd_edit_tunnel() {
  local d_role="" d_local="" d_remote="" d_tun="" d_peer="" d_ports="" d_speed=""
  [[ -f "$CONF" ]] || { echo "  No tunnel is configured."; return 0; }
  load_conf
  d_role="$ROLE"
  d_local="$LOCAL_IP"
  d_remote="$REMOTE_IP"
  d_tun="$TUN_IP"
  d_peer="$PEER_IP"
  d_ports="$PORTS"
  d_speed="${SPEED:-normal}"
  ROLE=""
  LOCAL_IP=""
  REMOTE_IP=""
  TUN_IP=""
  PEER_IP=""
  PORTS=""
  SPEED=""
  echo
  echo "  Edit tunnel. Press Enter to keep the current value."
  echo "  normal is the standard tunnel. fast uses the full link."
  echo "  Set the same speed on both servers."
  echo
  while true; do
    ask_line ROLE "Role of this server (iran or foreign)" "$d_role"
    if ROLE="$(normalize_role "$ROLE")"; then
      break
    fi
    echo "  Enter iran or foreign."
    ROLE=""
  done
  while true; do
    ask_line SPEED "Speed (normal or fast)" "$d_speed"
    if SPEED="$(normalize_speed "$SPEED")"; then
      break
    fi
    echo "  Enter normal or fast."
    SPEED=""
  done
  while ! is_ipv4 "${LOCAL_IP:-}"; do
    ask_line LOCAL_IP "Public IP of this server" "$d_local"
  done
  while ! is_ipv4 "${REMOTE_IP:-}"; do
    ask_line REMOTE_IP "Public IP of the other server" "$d_remote"
  done
  while ! is_ipv4 "${TUN_IP:-}"; do
    ask_line TUN_IP "Tunnel IP on this server" "$d_tun"
  done
  while ! is_ipv4 "${PEER_IP:-}"; do
    ask_line PEER_IP "Tunnel IP on the other server" "$d_peer"
  done
  if [[ "$ROLE" == "iran" ]]; then
    while [[ -z "$PORTS" ]]; do
      ask_line PORTS "Ports to forward (example: 443 8443)" "$d_ports"
      if ! PORTS="$(parse_ports "$PORTS")"; then
        echo "  Use ports from 1 to 65535, separated by spaces or commas."
        PORTS=""
        d_ports=""
        continue
      fi
      [[ -n "$PORTS" ]] || echo "  Enter at least one port."
    done
  else
    PORTS=""
  fi
  assert_tunnel_settings
  ensure_iran_packages
  write_tunnel_conf
  restart_service
  log_event notice "tunnel edited from the menu"
  echo "  Tunnel updated and restarted."
}

cmd_delete_tunnel() {
  local answer=""
  [[ -f "$CONF" ]] || { echo "  No tunnel is configured."; return 0; }
  printf '%b' "${C_YELLOW}  Delete this tunnel? [y/N]:${C_RESET} "
  read -r answer || true
  [[ "${answer:-}" =~ ^[Yy]$ ]] || { echo "  Cancelled."; return 0; }
  load_conf
  systemctl stop "$UNIT" >/dev/null 2>&1 || true
  systemctl disable "$UNIT" >/dev/null 2>&1 || true
  remove_forwards || true
  ip tunnel del "$TUN_NAME" >/dev/null 2>&1 || true
  rm -f "$CONF"
  rm -rf "$RUN_DIR"
  log_event notice "tunnel deleted from the menu"
  echo "  Tunnel deleted. The script is still installed."
}

release_file_ok() {
  local name="$1" dest="$2" line
  [[ -s "$dest" ]] || return 1
  if grep -qi '<html' "$dest"; then
    return 1
  fi
  line="$(head -n 1 "$dest" 2>/dev/null || true)"
  case "$name" in
    *.service|*.timer)
      grep -q '^\[Unit\]' "$dest" || return 1
      ;;
    *)
      [[ "$line" == '#!'* ]] || return 1
      bash -n "$dest" || return 1
      ;;
  esac
  return 0
}

fetch_release_file() {
  local name="$1" dest="$2" url errf stamp
  local -a urls=()
  stamp="$(date +%s)"
  urls=(
    "https://raw.githubusercontent.com/yasinznl/oxytunnel/main/${name}?t=${stamp}"
    "https://github.com/yasinznl/oxytunnel/raw/refs/heads/main/${name}?t=${stamp}"
    "https://cdn.jsdelivr.net/gh/yasinznl/oxytunnel@main/${name}?t=${stamp}"
  )
  errf="$(mktemp)"
  if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
    echo "  curl or wget is required to update."
    rm -f "$errf"
    return 1
  fi
  for url in "${urls[@]}"; do
    rm -f "$dest"
    if command -v curl >/dev/null 2>&1; then
      if curl -fL --retry 2 --retry-delay 1 --connect-timeout 20 --max-time 90 "$url" -o "$dest" 2>"$errf"; then
        if release_file_ok "$name" "$dest"; then
          rm -f "$errf"
          return 0
        fi
      fi
    elif wget -q -O "$dest" "$url" 2>"$errf"; then
      if release_file_ok "$name" "$dest"; then
        rm -f "$errf"
        return 0
      fi
    fi
  done
  echo "  Download failed: ${name}"
  if [[ -s "$errf" ]]; then
    tail -n 2 "$errf" | sed 's/^/  /'
  fi
  rm -f "$errf" "$dest"
  return 1
}

cmd_update() {
  local answer="" stage="" was_active=0 asset
  local -a assets=(
    oxytunnel-lib.sh
    oxytunnel-up.sh
    oxytunnel-down.sh
    oxytunnel-health.sh
    oxytunnel
    oxytunnel.service
    oxytunnel-health.service
    oxytunnel-health.timer
  )
  printf '%b' "${C_YELLOW}  Download and install the latest script? [y/N]:${C_RESET} "
  read -r answer || true
  [[ "${answer:-}" =~ ^[Yy]$ ]] || { echo "  Cancelled."; return 0; }
  if systemctl is-active --quiet "$UNIT"; then
    was_active=1
  fi
  stage="$(mktemp -d)"
  echo "  Downloading..."
  for asset in "${assets[@]}"; do
    echo "  ${asset}"
    if ! fetch_release_file "$asset" "${stage}/${asset}"; then
      rm -rf "$stage"
      echo "  Update stopped. The installed script was not changed."
      return 1
    fi
  done
  install -d /usr/local/bin /usr/local/lib/oxytunnel /etc/systemd/system
  install -m 0644 "${stage}/oxytunnel-lib.sh" /usr/local/lib/oxytunnel/lib.sh
  install -m 0755 "${stage}/oxytunnel-up.sh" /usr/local/bin/oxytunnel-up
  install -m 0755 "${stage}/oxytunnel-down.sh" /usr/local/bin/oxytunnel-down
  install -m 0755 "${stage}/oxytunnel-health.sh" /usr/local/bin/oxytunnel-health
  install -m 0755 "${stage}/oxytunnel" /usr/local/bin/oxytunnel
  install -m 0644 "${stage}/oxytunnel.service" /etc/systemd/system/oxytunnel.service
  install -m 0644 "${stage}/oxytunnel-health.service" /etc/systemd/system/oxytunnel-health.service
  install -m 0644 "${stage}/oxytunnel-health.timer" /etc/systemd/system/oxytunnel-health.timer
  rm -rf "$stage"
  systemctl daemon-reload
  systemctl enable oxytunnel-health.timer >/dev/null 2>&1 || true
  if [[ "$was_active" -eq 1 && -f "$CONF" ]]; then
    echo "  Restarting the tunnel..."
    systemctl restart "$UNIT" || true
  fi
  log_event notice "script updated from ${BASE_URL}"
  echo "  Update installed."
  echo "  Open Tunnels, then Edit tunnel, and set Speed to fast or normal."
  exec /usr/local/bin/oxytunnel
}

cmd_uninstall() {
  local answer="" tun_name="oxytunnel"
  echo
  echo "  This removes oxytunnel, the tunnel, forwards, config, and log."
  printf '%b' "${C_RED}  Type yes to uninstall:${C_RESET} "
  read -r answer || true
  [[ "${answer:-}" == "yes" ]] || { echo "  Cancelled."; pause_menu; return 0; }
  systemctl disable --now oxytunnel-health.timer >/dev/null 2>&1 || true
  systemctl stop "$UNIT" >/dev/null 2>&1 || true
  systemctl disable "$UNIT" >/dev/null 2>&1 || true
  if [[ -f "$CONF" ]]; then
    # shellcheck disable=SC1090
    source "$CONF" || true
    tun_name="${TUN_NAME:-oxytunnel}"
    remove_forwards || true
  fi
  ip tunnel del "$tun_name" >/dev/null 2>&1 || true
  ip tunnel del sudotunnel >/dev/null 2>&1 || true
  rm -f \
    /usr/local/bin/oxytunnel \
    /usr/local/bin/oxytunnel-up \
    /usr/local/bin/oxytunnel-down \
    /usr/local/bin/oxytunnel-health \
    /etc/systemd/system/oxytunnel.service \
    /etc/systemd/system/oxytunnel-health.service \
    /etc/systemd/system/oxytunnel-health.timer \
    /etc/oxytunnel.conf \
    /etc/sysctl.d/99-oxytunnel.conf \
    /var/log/oxytunnel.log \
    /usr/local/bin/sudotunnel \
    /usr/local/bin/sudotunnel-up \
    /usr/local/bin/sudotunnel-down \
    /etc/systemd/system/sudotunnel.service \
    /etc/sudotunnel.conf \
    /etc/sysctl.d/99-sudotunnel.conf
  rm -rf /usr/local/lib/oxytunnel /usr/local/lib/sudotunnel /run/oxytunnel
  systemctl daemon-reload || true
  echo "  Oxytunnel has been uninstalled."
  exit 0
}

cmd_tunnels() {
  local choice="" state="down"
  while true; do
    echo
    printf '%b\n' "${C_BOLD}  Tunnels${C_RESET}"
    ui_rule
    if [[ ! -f "$CONF" ]]; then
      echo "  No tunnel is configured."
      echo "  Create one with New tunnel."
      ui_rule
      pause_menu
      return 0
    fi
    load_conf
    if systemctl is-active --quiet "$UNIT" && ip link show "$TUN_NAME" >/dev/null 2>&1; then
      state="up"
    else
      state="down"
    fi
    printf '  %-14s %-10s %-8s %s\n' "NAME" "ROLE" "STATE" "PUBLIC"
    printf '  %-14s %-10s %-8s %s\n' "$TUN_NAME" "$ROLE" "$state" "${LOCAL_IP} -> ${REMOTE_IP}"
    printf '  %-14s %s\n' "TUNNEL" "${TUN_IP}/${CIDR} -> ${PEER_IP}"
    printf '  %-14s %s\n' "SPEED" "$SPEED"
    if [[ -n "${PORTS:-}" ]]; then
      printf '  %-14s %s\n' "PORTS" "$PORTS"
    else
      printf '  %-14s %s\n' "PORTS" "none"
    fi
    ui_rule
    echo "  1   Start"
    echo "  2   Stop"
    echo "  3   Tunnel log"
    echo "  4   Edit tunnel"
    echo "  5   Ports"
    echo "  6   Delete tunnel"
    echo "  0   Back"
    printf '%b' "${C_CYAN}  Select:${C_RESET} "
    if ! read -r choice; then
      echo
      return 0
    fi
    case "$choice" in
      1) cmd_start || true; pause_menu ;;
      2) cmd_stop || true; pause_menu ;;
      3) echo; cmd_log 40 || true; pause_menu ;;
      4) ( cmd_edit_tunnel ) || true; pause_menu ;;
      5) cmd_ports_menu || true ;;
      6) cmd_delete_tunnel || true; pause_menu; [[ -f "$CONF" ]] || return 0 ;;
      0|back) return 0 ;;
      *) echo "  Choose an option from the list."; pause_menu ;;
    esac
  done
}

cmd_stop() {
  if [[ ! -f "$CONF" ]]; then
    echo "  No tunnel is configured."
    return 0
  fi
  systemctl stop "$UNIT"
  log_event notice "tunnel stopped from the menu"
  echo "  Tunnel stopped."
  echo "  The health timer will leave it stopped until you restart it."
}

cmd_ports_menu() {
  local choice="" port=""
  local -a ports=()
  while true; do
    echo
    printf '%b\n' "${C_BOLD}  Ports${C_RESET}"
    echo "  1   List"
    echo "  2   Add"
    echo "  3   Remove"
    echo "  4   Replace list"
    echo "  0   Back"
    printf '%b' "${C_CYAN}  Select:${C_RESET} "
    read -r choice || return 0
    case "$choice" in
      1) cmd_port_list || true ;;
      2)
        printf '  Port to add: '
        read -r port || true
        if [[ -n "${port:-}" ]]; then
          ( cmd_port_add "$port" ) || true
        fi
        ;;
      3)
        printf '  Port to remove: '
        read -r port || true
        if [[ -n "${port:-}" ]]; then
          ( cmd_port_del "$port" ) || true
        fi
        ;;
      4)
        printf '  Ports (example: 443 8443): '
        read -r -a ports || ports=()
        if [[ ${#ports[@]} -gt 0 ]]; then
          ( cmd_port_set "${ports[@]}" ) || true
        fi
        ;;
      0|back) return 0 ;;
      *) echo "  Choose 0, 1, 2, 3, or 4." ;;
    esac
  done
}

cmd_menu() {
  local choice=""
  while true; do
    menu_banner
    echo "  1   Status"
    echo "  2   New tunnel"
    echo "  3   Tunnels"
    echo "  4   Health check"
    echo "  5   Update script"
    echo "  6   Uninstall script"
    echo "  0   Exit"
    ui_rule
    printf '%b' "${C_DIM}  root only${C_RESET}  ${C_CYAN}Select an option:${C_RESET} "
    if ! read -r choice; then
      echo
      break
    fi
    case "$choice" in
      1) cmd_status || true; pause_menu ;;
      2) ( cmd_new_tunnel ) || true; pause_menu ;;
      3) cmd_tunnels || true ;;
      4) cmd_health || true; pause_menu ;;
      5) cmd_update || true; pause_menu ;;
      6) cmd_uninstall || true ;;
      0|q|Q|exit) break ;;
      *) echo "  Choose an option from the list."; pause_menu ;;
    esac
  done
}

main() {
  local cmd="${1:-menu}"
  case "$cmd" in
    -h|--help|help) usage; exit 0 ;;
  esac
  require_root
  if [[ $# -eq 0 ]]; then
    if [[ -t 0 ]]; then
      cmd_menu
    else
      cmd_status
    fi
    exit 0
  fi
  case "$cmd" in
    menu) cmd_menu ;;
    setup|new) cmd_new_tunnel ;;
    tunnels) cmd_tunnels ;;
    stop) cmd_stop ;;
    status) cmd_status ;;
    health|check) cmd_health ;;
    log|logs) shift || true; cmd_log "${1:-40}" ;;
    restart|reload)
      load_conf
      restart_service
      echo "Restarted (${ROLE})."
      ;;
    port|ports)
      shift
      local sub="${1:-list}"
      case "$sub" in
        list) cmd_port_list ;;
        add) shift; cmd_port_add "$@" ;;
        del|delete|rm|remove) shift; cmd_port_del "$@" ;;
        set) shift; cmd_port_set "$@" ;;
        *) usage; exit 1 ;;
      esac
      ;;
    role) shift; cmd_role "${1:-}" ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
