[Unit]
Description=GRE tunnel and Iran port forward (sudotunnel)
Wants=network-online.target
After=network-online.target netfilter-persistent.service ufw.service firewalld.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sudotunnel-up
ExecStop=/usr/local/bin/sudotunnel-down
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
